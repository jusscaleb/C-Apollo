{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Apollo File",
      "type": "shell",
      "command": "gcc -o2  \"${workspaceFolder}\\apl.c\" -o \"${workspaceFolder}\\apl.exe\"; cd \"${fileDirname}\"; & \"${workspaceFolder}\\apl.exe\" \"${file}\" \"${workspaceFolder}\"",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
